PORT=4173
# Necessaria para a rotina automática de exclusão e limpeza dos anexos privados
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# URL publica HTTPS usada nos links de acompanhamento retornados a Meta
PUBLIC_BASE_URL=https://pedeia.onrender.com
# Banco PostgreSQL/Supabase obrigatório para pedidos e rastreamento
DATABASE_URL=postgresql://usuario:senha@host:5432/banco
# Chave privada do OpenRouteService, somente no servidor
ORS_API_KEY=
# Segredo do aplicativo Meta usado exclusivamente no callback de exclusao de dados
META_APP_SECRET=
